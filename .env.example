# Copie para .env e preencha. Nunca versione o .env com valores reais.

# ---------------------------------------------------------------- Django
DJANGO_DEBUG=true
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
LOG_LEVEL=INFO

# ---------------------------------------------------------------- Banco (PostgreSQL / Supabase)
# A API conecta como app_django (sem BYPASSRLS), nunca como dono do esquema. Configure UM modo:
#
# 1) DB_*  (convenção do grupo; TEM PRIORIDADE: vale sempre que DB_HOST estiver preenchido)
#    DB_SSLMODE: padrão "prefer" em localhost/127.0.0.1/db e "require" nos demais; "disable" só em banco local.
# DB_HOST=
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=app_django
# DB_PASSWORD=
# DB_SSLMODE=require
#
# 2) DATABASE_URL  (senha com @, # ou / precisa ir codificada: %40, %23, %2F)
# DATABASE_URL=postgres://app_django:SENHA@HOST:5432/postgres?sslmode=require
#
# Sem nenhum dos dois, a API tenta postgres://app_django:app_django@localhost:5432/netafim (só local).
# Supabase: Session pooler (IPv4, porta 5432); o usuário vira app_django.<ref-do-projeto>.
#
# POSTGRES_* servem SÓ ao docker-compose.yml (criam o banco do contêiner "db"); a API não as lê.
POSTGRES_DB=netafim
POSTGRES_USER=netafim
POSTGRES_PASSWORD=
# Conexão separada só para conferir senha (DT-002): papel app_auth, sem privilégio em tabela.
# No pooler do Supabase o usuário é "app_auth.<ref-do-projeto>". A senha é definida no banco com
# ALTER ROLE app_auth WITH PASSWORD '...' e NUNCA vai para o repositório. Com DB_HOST ela é obrigatória.
# DB_AUTH_USER=app_auth
# DB_AUTH_PASSWORD=

# ---------------------------------------------------------------- Autenticação (módulo de acesso)
# Chave própria para assinar os JWT; se vazia, usa DJANGO_SECRET_KEY.
JWT_SIGNING_KEY=
JWT_ACCESS_MINUTOS=15
REFRESH_DIAS=30
MAX_FALHAS_LOGIN=5
BLOQUEIO_MINUTOS=15
VERSAO_TERMO_VIGENTE=1.0
# Link aberto pelo app nos e-mails de convite e redefinição de senha.
URL_APP_CONVITE=netafim://convite
THROTTLE_LOGIN=10/min
THROTTLE_CADASTRO=5/hour

# ---------------------------------------------------------------- E-mail
# Em desenvolvimento os e-mails aparecem no console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=nao-responda@netafim.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
